# ===== Thndr Companion — Environment variables =====
# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and must NEVER be committed or shared publicly.

# NaraRouter API key — kept ONLY on the backend, never exposed to the frontend.
NARAROUTER_API_KEY=your_nararouter_api_key_here

# Base URL of the NaraRouter API (OpenAI-compatible chat completions endpoint).
NARAROUTER_BASE_URL=https://router.bynara.id/v1

# Default model used for the AI assistant. Change this single line to switch models.
# e.g. mistral-medium-3-5 for solid analysis, or an economic model like tencent-hy3.
NARAROUTER_MODEL=mistral-medium-3-5

# Local server port.
PORT=3000

# --- Optional: Basic Auth for REMOTE deployment only (e.g. behind Tailscale) ---
# Leave BOTH empty for local use — the app then runs with no login, unchanged.
# Set BOTH to require a username/password when the server is reachable from
# other devices. Do not commit real values.
APP_USERNAME=
APP_PASSWORD=
